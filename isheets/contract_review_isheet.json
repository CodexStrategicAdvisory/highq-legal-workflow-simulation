{
  "name": "Contract Review iSheet",
  "description": "Structured data model for tracking contracts through a review workflow.",
  "columns": [
    { "name": "Contract ID", "type": "text", "required": true, "unique": true },
    { "name": "Counterparty", "type": "text", "required": true },
    { "name": "Contract Type", "type": "choice", "required": true,
      "options": ["MSA", "NDA", "SOW", "License", "Other"] },
    { "name": "Risk Level", "type": "choice", "required": true,
      "options": ["Low", "Medium", "High"] },
    { "name": "Status", "type": "choice", "required": true,
      "options": ["Intake", "In Review", "On Hold", "Approved", "Rejected"] },
    { "name": "Assigned Reviewer", "type": "user", "required": false },
    { "name": "Intake Date", "type": "date", "required": true },
    { "name": "Target Completion Date", "type": "date", "required": false },
    { "name": "Actual Completion Date", "type": "date", "required": false },
    { "name": "Comments", "type": "text", "required": false }
  ],
  "validationRules": [
    {
      "name": "High risk must have reviewer",
      "condition": "Risk Level == 'High' AND Status != 'Intake'",
      "require": ["Assigned Reviewer"]
    }
  ],
  "sampleRows": [
